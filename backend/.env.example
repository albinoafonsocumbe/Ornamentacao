# ═══════════════════════════════════════════════════
# .env.example — Copia para .env e preenche os valores
# NÃO commitar o .env com valores reais no git
# ═══════════════════════════════════════════════════

PORT=3000

# ── Base de dados PostgreSQL ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plataforma-ornamentacao
DB_USER=postgres
DB_PASSWORD=

# ── Autenticação JWT ─────────────────────────────
# Gerar uma string aleatória longa e segura:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Email (SMTP) ─────────────────────────────────
# Gmail: myaccount.google.com > Segurança > Passwords de aplicação
# Outros: usar host/porta do teu fornecedor de email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_ADMIN=

# ── WhatsApp ─────────────────────────────────────
# Número internacional sem + nem espaços
# Ex: Moçambique +258 84 123 4567 → 258841234567
WHATSAPP_NUMBER=

# ── URLs ─────────────────────────────────────────
ADMIN_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
