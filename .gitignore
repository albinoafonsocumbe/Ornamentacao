# ── Dependências ─────────────────────────────────
node_modules/
**/node_modules/

# ── Variáveis de ambiente (NUNCA commitar) ────────
.env
backend/.env
frontend/.env
# O .env.example pode (e deve) ser commitado
!backend/.env.example
!frontend/.env.example

# ── Build do frontend ─────────────────────────────
frontend/build/

# ── Uploads (imagens do portefólio) ──────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# ── Sistema operativo ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Coverage / testes ─────────────────────────────
coverage/
